# Public site URL (used for SEO metadata)
NEXT_PUBLIC_SITE_URL=https://softglambysteph.com

# Supabase (optional). When set, products are read from Supabase and
# bookings / orders / newsletter sign-ups are stored there as well as sent to WhatsApp.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Paystack (optional). The "Pay with card" button only appears when the public key is set.
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=
# Server only — used to verify transactions and webhook signatures. Never expose.
PAYSTACK_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=
